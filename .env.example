NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=pocketmed_user
DB_PASSWORD=pocketmed_pass
DB_DATABASE=pocketmed

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=pocketmed-images

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Email / Resend
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Sender displayed in recipient inbox (must be a verified domain in Resend)
# Use the new verified domain hispora.com.br
EMAIL_FROM="Hispora <noreply@hispora.com.br>"

# Local dev helper:
# true  -> tries to send real emails using Resend API
# false -> does not send; logs verification/reset code in backend console
EMAIL_ENABLED=false

# If sending fails (bad API key/rate limit), should API fallback to mock log mode?
# Recommended true in local development.
EMAIL_MOCK_FALLBACK=true

# Base URL of the web app, used to build payment checkout/return links.
# IMPORTANT: Mercado Pago rejects non-HTTPS `back_url`s outright ("Invalid
# value for back_url, must be a valid URL"). To test the real checkout
# redirect locally, point this at an HTTPS tunnel to your dev server (e.g.
# ngrok/cloudflared) instead of http://localhost — otherwise "Selecionar
# Plano" will fail with a 400 as soon as it calls Mercado Pago.
FRONTEND_URL=http://localhost:5173

# Stripe (payment gateway for clinic subscriptions)
# Leave all of these blank until a Stripe account is created — the
# subscription endpoints degrade gracefully (503) without them, and the
# existing manual/free plan-selection path keeps working either way.
# Get these at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Get this after creating the webhook endpoint at
# https://dashboard.stripe.com/webhooks -> POST {API_URL}/webhooks/stripe
# (events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=
# One recurring monthly Price id per self-serve plan (create a Product +
# Price in Stripe for each). Enterprise is negotiated manually, no price here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# Optional: per-extra-professional add-on Price id per plan (Premium's
# add-on is negotiated manually, so it has none).
STRIPE_PRICE_ADDON_STARTER=
STRIPE_PRICE_ADDON_PLUS=
STRIPE_PRICE_ADDON_PRO=

# Mercado Pago (active payment gateway for clinic subscriptions in Brazil —
# supports PIX/boleto/cartão natively, unlike Stripe above).
# Get these at https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Set after creating a webhook subscription in the MP dashboard pointing to
# {API_URL}/webhooks/mercadopago (Developer Panel -> Webhooks -> Secret key).
MERCADOPAGO_WEBHOOK_SECRET=
