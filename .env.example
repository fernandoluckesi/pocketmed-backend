NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=pocketmed_user
DB_PASSWORD=pocketmed_pass
DB_DATABASE=pocketmed

# Encrypts the connection to MySQL. Opt-in, off by default — see the comment
# next to `ssl:` in app.module.ts/data-source.ts before turning this on in
# production: it hasn't been verified against the real Railway MySQL
# instance, and a bad TLS assumption here breaks ALL database connectivity.
# DB_SSL_REJECT_UNAUTHORIZED=true only if the provider gives you a CA to
# validate against (Railway's managed MySQL typically doesn't).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Signs single-document access tokens (the links sent for prescriptions/exam
# requests, usable without login). Deliberately a DIFFERENT secret from
# JWT_SECRET above — never reuse it, so a leak of one can never forge a
# token of the other kind. See src/documents/document-access-token.service.ts.
DOCUMENT_ACCESS_SECRET=another-super-secret-change-in-production

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=pocketmed-images
# Public URL used to build the links returned for uploaded files (photos,
# documents, exams, etc). Required whenever MINIO_ENDPOINT is not reachable
# from the browser/client as-is — e.g. in Docker, where MINIO_ENDPOINT is set
# to the internal service name ("minio") so the API container can reach it,
# but a browser on the host machine needs http://localhost:9000 instead.
MINIO_PUBLIC_URL=http://localhost:9000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Email / Resend
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Sender displayed in recipient inbox (must be a verified domain in Resend)
# Use the new verified domain hispora.com.br
EMAIL_FROM="Hispora <noreply@hispora.com.br>"

# Local dev helper:
# true  -> tries to send real emails using Resend API
# false -> does not send; logs verification/reset code in backend console
EMAIL_ENABLED=false

# If sending fails (bad API key/rate limit), should API fallback to mock log mode?
# Recommended true in local development.
EMAIL_MOCK_FALLBACK=true

# This backend's own public base URL, used to build the /documents/access/:token
# links embedded in the end-of-consultation email (see
# src/patients/consultation-summary-email.service.ts). Those links point at
# this API directly, not at the web app, since opening one just 302-redirects
# straight to the document — no page to render.
API_PUBLIC_URL=http://localhost:3000

# Base URL of the web app, used to build payment checkout/return links.
# IMPORTANT: Mercado Pago rejects non-HTTPS `back_url`s outright ("Invalid
# value for back_url, must be a valid URL"). To test the real checkout
# redirect locally, point this at an HTTPS tunnel to your dev server (e.g.
# ngrok/cloudflared) instead of http://localhost — otherwise "Selecionar
# Plano" will fail with a 400 as soon as it calls Mercado Pago.
FRONTEND_URL=http://localhost:5173

# Base URL of the published web app, used to build links inside emails
# (verification, password reset) and to locate the brand logo assets served
# from the web app's public/ folder. Override the logo URLs individually only
# if you need to serve them from somewhere else.
WEB_URL=http://localhost:5173
EMAIL_LOGO_URL=
EMAIL_LOGO_HORIZONTAL_URL=

# Cross-clinic record-sharing authorization (patient Shadow flow): how long,
# in minutes, a granted DoctorPermission stays valid after the patient
# authorizes a cross-clinic access request. Leave unset for the 120-minute
# (2h) default.
CROSS_CLINIC_ACCESS_WINDOW_MINUTES=120

# Stripe (payment gateway for clinic subscriptions)
# Leave all of these blank until a Stripe account is created — the
# subscription endpoints degrade gracefully (503) without them, and the
# existing manual/free plan-selection path keeps working either way.
# Get these at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Get this after creating the webhook endpoint at
# https://dashboard.stripe.com/webhooks -> POST {API_URL}/webhooks/stripe
# (events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=
# One recurring monthly Price id per self-serve plan (create a Product +
# Price in Stripe for each). Enterprise is negotiated manually, no price here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# Optional: per-extra-professional add-on Price id per plan (Premium's
# add-on is negotiated manually, so it has none).
STRIPE_PRICE_ADDON_STARTER=
STRIPE_PRICE_ADDON_PLUS=
STRIPE_PRICE_ADDON_PRO=

# Mercado Pago (active payment gateway for clinic subscriptions in Brazil —
# supports PIX/boleto/cartão natively, unlike Stripe above).
# Get these at https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Set after creating a webhook subscription in the MP dashboard pointing to
# {API_URL}/webhooks/mercadopago (Developer Panel -> Webhooks -> Secret key).
MERCADOPAGO_WEBHOOK_SECRET=

# Cloudflare Turnstile (CAPTCHA on public registration forms — patient,
# doctor, and clinic signup).
# Get these at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable captcha verification (local/dev default).
TURNSTILE_SECRET_KEY=
